# Copy to backend/.env and fill in values. Never commit .env.

# App
APP_NAME=Cafe Kaya API
DEBUG=false

# Database (PostgreSQL, async driver). Required.
# Example shape: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
CAFE_DATABASE_URL=

# JWT signing key. Required; use at least 32 random characters.
JWT_SECRET=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=

# Local Postgres via backend/docker-compose.yml (used for ${VAR} substitution)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Cloudinary (optional, for image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Google Places (optional, for review sync)
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
# GOOGLE_REVIEWS_CACHE_HOURS=12
