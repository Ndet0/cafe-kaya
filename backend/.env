# App
APP_NAME=Cafe Kaya API
DEBUG=false

# Database (PostgreSQL). Use async driver: postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cafe_kaya

# JWT
JWT_SECRET=REDACTED-JWT-SECRET-REPLACED
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://127.0.0.1:5173

# Cloudinary (optional, for image uploads)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
